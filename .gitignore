# Whitelist: only code and aggregate results are tracked. Raw data, signal caches,
# model checkpoints, per-run predictions and manuscript files stay local.
/*
!/.gitignore
!/README.md
!/LICENSE
!/requirements.txt
!/run_grid.sh
!/post_grid.sh
!/run_broad.sh

!/src/
/src/*
!/src/__init__.py
!/src/config.py
!/src/model.py
!/src/train.py
!/src/evaluate.py
!/src/run_grid.py
!/src/data_prep.py
!/src/data_prep_ptbxl.py
!/src/data_prep_snomed.py
!/src/dedupe.py
!/src/features_gbm.py
!/src/aggregate_seeds.py
!/src/concordance.py
!/src/confusion_v2.py
!/src/figures_v2.py
!/src/tables_v2.py
!/src/supplement_v2.py

!/artifacts_v2/
/artifacts_v2/*
!/artifacts_v2/aggregate/
!/artifacts_v2/aggregate_broad/
!/artifacts_v2/dedupe/
/artifacts_v2/dedupe/*
!/artifacts_v2/dedupe/exclusions.csv
__pycache__/
